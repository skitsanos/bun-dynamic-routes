{
  "name": "bun-dynamic-routes",
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "compile": "bun build --compile --production src/index.ts --outfile dist/demo",
    "lint": "bunx biome check . --error-on-warnings",
    "lint:fix": "bunx biome check . --write",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test tests",
    "test:compiled": "bun scripts/test-compiled.ts",
    "test:docker": "bun scripts/test-docker.ts",
    "test:hurl": "bun scripts/test-hurl.ts",
    "skill:sync": "bun scripts/sync-skill.ts --write",
    "skill:check": "bun scripts/sync-skill.ts --check",
    "check": "bun run typecheck && bun run lint && bun run test",
    "verify": "bun run check && bun run test:compiled"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
